@echo off
chcp 65001 >nul
title MES 系统 - 全栈容器安全停止
echo ===================================================================
echo [MES 停止工具] 正在安全停止 MES 全套容器集群 (保留持久化数据)...
echo ===================================================================

cd /d "%~dp0"

docker compose down
if %errorlevel% neq 0 (
    echo.
    echo [错误] 容器停止失败!
    pause
    exit /b %errorlevel%
)

echo.
echo ===================================================================
echo [成功] MES 系统集群已安全停止 (数据持久化保留在本地目录中)。
echo ===================================================================
pause
