# ===================================================================
# MES 全栈容器编排环境变量配置模板 (复制为 .env 使用)
# ===================================================================

# 端口映射配置 (对外服务暴露端口)
FRONTEND_PORT=1228
BACKEND_PORT=48080
MYSQL_PORT=3307
REDIS_PORT=6379

# MySQL 数据库配置 (直观明文，修改此处即可全局生效)
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ruoyi-vue-pro

# Redis 密码配置 (无密码留空，有密码直接填写)
REDIS_PASSWORD=

# 后端 JVM 启动堆内存与GC调优参数 (可根据服务器内存调整，如 8G内存推荐 -Xms2g -Xmx4g)
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -Dfile.encoding=UTF-8
